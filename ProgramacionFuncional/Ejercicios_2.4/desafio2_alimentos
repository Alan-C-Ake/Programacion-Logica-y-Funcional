def preparar_pizza():
    return "🍕pizza"

def preparar_hamburguesa():
    return "🍔hamburguesa"

def preparar_hotdog():
    return "🌭hotdog"

def cal_bonus(num_porciones):
    return "coca gratis" if num_porciones > 2 else ""

def ordenar_alimento(preparar_alimento, num_porciones):
    porciones_alimento = [preparar_alimento() for _ in range(num_porciones)]
    bonus = cal_bonus(num_porciones)
    return porciones_alimento, bonus 

